# chess-manager no usa dotenv: estas variables deben exportarse en el entorno real
# (systemd unit, proceso manager, shell profile, etc). Este archivo es solo documentación.

# --- Autenticación del organizador ---

# Hash scrypt del password del organizador. Generalo con:
#   npm run hash-password
# y pegá la salida completa (formato scrypt:N:r:p:salt:hash) acá.
# Si no está seteada, el login queda deshabilitado (la app sigue en modo solo-lectura).
ORGANIZER_PASSWORD_HASH=

# Secret usado para firmar la cookie de sesión. Cualquier string largo y aleatorio.
# Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si no está seteada, se genera un secret efímero en memoria al arrancar el server
# (las sesiones no sobreviven un reinicio).
SESSION_COOKIE_SECRET=

# Duración de la sesión en horas (con renovación mientras haya actividad). Default: 12
SESSION_TTL_HOURS=12

# --- Variables ya existentes (documentadas acá para referencia) ---
NODE_ENV=production
PORT=3001
DATA_DIR=./data
DB_PATH=
