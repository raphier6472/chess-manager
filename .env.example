# Enroque no usa dotenv: estas variables deben exportarse en el entorno real
# (unidad de systemd, gestor de procesos, perfil del shell). Este archivo es solo
# documentación de referencia; copiarlo a .env no tiene ningún efecto.

# --- Acceso del organizador ---

# Hash scrypt de la contraseña del organizador. Genéralo con:
#   npm run hash-password
# y pega aquí la salida completa (formato scrypt:N:r:p:salt:hash).
# Si no se define, el acceso de organizador queda deshabilitado y la aplicación
# funciona en modo solo lectura.
ORGANIZER_PASSWORD_HASH=

# Nombre a mostrar en la interfaz cuando hay una sesión de organizador activa.
# Opcional: si se omite, la interfaz muestra solo "Organizador".
ORGANIZER_NAME=

# Secreto para firmar la cookie de sesión. Cualquier cadena larga y aleatoria.
# Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si no se define, se genera uno efímero en memoria al arrancar y las sesiones
# no sobreviven a un reinicio del servidor.
SESSION_COOKIE_SECRET=

# Duración de la sesión en horas, renovada mientras haya actividad. Por defecto: 12
SESSION_TTL_HOURS=12

# --- Servidor ---

# Con "production" el mismo proceso sirve la interfaz compilada de dist/ además de
# la API, y la cookie de sesión se marca como "secure" (solo viaja por HTTPS).
# Publica el sitio detrás de un proxy con TLS; por HTTP plano el inicio de sesión
# no persistirá.
NODE_ENV=production

# Puerto donde escucha el servidor. Por defecto: 3001
PORT=3001

# --- Base de datos (SQLite) ---

# Carpeta donde vive el archivo de la base. Se crea si no existe. Por defecto: ./data
DATA_DIR=./data

# Ruta explícita del archivo de base de datos. Si se omite, se usa
# $DATA_DIR/chess-manager.db. Acepta ":memory:" para una base en memoria, que es
# lo que usan las pruebas automatizadas.
DB_PATH=
